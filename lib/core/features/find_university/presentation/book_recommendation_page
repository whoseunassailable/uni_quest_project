import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';

class BookRecommendationPage extends StatefulWidget {
  const BookRecommendationPage({super.key});

  @override
  State<BookRecommendationPage> createState() => _BookRecommendationPageState();
}

class _BookRecommendationPageState extends State<BookRecommendationPage> {
  String? selectedGenre;
  List<String> recommendedBooks = [];

  @override
  void initState() {
    super.initState();
    _loadGenre();
  }

  _loadGenre() async {
    final sharedPreferences = await SharedPreferences.getInstance();
    setState(() {
      selectedGenre = sharedPreferences.getString('preferred_genre');
      _getRecommendations(selectedGenre);
    });
  }

  _getRecommendations(String? genre) {
    if (genre == null) {
      return;
    }

    // Simple logic to provide book recommendations based on genre (you can replace this with real data or API call)
    if (genre == "Adventure") {
      recommendedBooks = ["The Hobbit", "Treasure Island", "Journey to the Center of the Earth"];
    } else if (genre == "Fantasy") {
      recommendedBooks = ["Harry Potter Series", "The Lord of the Rings", "A Song of Ice and Fire"];
    } else if (genre == "Romance") {
      recommendedBooks = ["Pride and Prejudice", "The Fault in Our Stars", "The Notebook"];
    } else if (genre == "Science Fiction (Sci-Fi)") {
      recommendedBooks = ["Dune", "Ender's Game", "Neuromancer"];
    } else {
      recommendedBooks = ["The Great Gatsby", "1984", "To Kill a Mockingbird"];
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text("Book Recommendations"),
      ),
      body: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Center(
          child: selectedGenre == null
              ? const Text("Please select a genre to get recommendations.")
              : Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      "Recommended Books for '$selectedGenre':",
                      style: const TextStyle(
                        fontSize: 18,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const SizedBox(height: 16),
                    ...recommendedBooks.map((book) => Text(book)).toList(),
                  ],
                ),
        ),
      ),
    );
  }
}
